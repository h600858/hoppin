{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.innhopp.no/substituteStats.schema.json",
  "title": "SubstituteStats",
  "description": "History computed by the system for the score function (plan 7.3 and 7.8). Collection: substituteStats, document ID is the substitute ID. Kept apart from substitutes so the profile the substitute edits never mixes with computed data. A substitute without a document is new and gets neutral priors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId", "substituteId", "computedAt", "offersTotal", "offersAccepted",
    "offeredByWeekday", "acceptedByWeekday", "assignmentsTotal",
    "assignmentsLast30Days", "attendanceRate", "lateCancellationRate",
    "schoolRating", "classVisits", "lastOfferedAt"
  ],
  "properties": {
    "tenantId": { "$ref": "common.schema.json#/$defs/DocumentId" },
    "substituteId": { "$ref": "common.schema.json#/$defs/DocumentId" },
    "computedAt": { "$ref": "common.schema.json#/$defs/Instant" },
    "offersTotal": { "type": "integer", "minimum": 0 },
    "offersAccepted": { "type": "integer", "minimum": 0 },
    "offeredByWeekday": {
      "description": "Offers per weekday, Monday first.",
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 7,
      "maxItems": 7
    },
    "acceptedByWeekday": {
      "description": "Accepted offers per weekday, Monday first.",
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 7,
      "maxItems": 7
    },
    "assignmentsTotal": { "type": "integer", "minimum": 0 },
    "assignmentsLast30Days": { "type": "integer", "minimum": 0 },
    "attendanceRate": {
      "description": "Share of assignments attended. Null until there is data.",
      "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
    },
    "lateCancellationRate": {
      "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
    },
    "schoolRating": {
      "description": "Average feedback from schools, 0 to 5. Personal data, visible on access request.",
      "anyOf": [{ "type": "number", "minimum": 0, "maximum": 5 }, { "type": "null" }]
    },
    "classVisits": {
      "description": "Dates of earlier assignments per class, for class familiarity with time decay.",
      "type": "array",
      "items": {
        "title": "ClassVisits",
        "type": "object",
        "additionalProperties": false,
        "required": ["schoolId", "className", "dates"],
        "properties": {
          "schoolId": { "$ref": "common.schema.json#/$defs/DocumentId" },
          "className": { "$ref": "common.schema.json#/$defs/ClassName" },
          "dates": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/LocalDate" }
          }
        }
      }
    },
    "lastOfferedAt": {
      "anyOf": [{ "$ref": "common.schema.json#/$defs/Instant" }, { "type": "null" }]
    }
  }
}
