{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.innhopp.no/common.schema.json",
  "title": "CommonDefinitions",
  "description": "Shared building blocks. Not a collection.",
  "$defs": {
    "DocumentId": {
      "title": "DocumentId",
      "description": "Firestore document ID.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Instant": {
      "title": "Instant",
      "description": "Point in time, UTC, ISO 8601. Stored as Firestore Timestamp.",
      "type": "string",
      "format": "date-time"
    },
    "LocalDate": {
      "title": "LocalDate",
      "description": "Calendar date without time, YYYY-MM-DD.",
      "type": "string",
      "format": "date"
    },
    "LocalTime": {
      "title": "LocalTime",
      "description": "Wall clock time HH:mm in the school's time zone.",
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "Weekday": {
      "title": "Weekday",
      "description": "ISO weekday, Monday is 1.",
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "Grade": {
      "title": "Grade",
      "description": "Trinn 1 to 10.",
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "ClassName": {
      "title": "ClassName",
      "description": "Class as the school writes it, for example 5B.",
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "PhoneNumber": {
      "title": "PhoneNumber",
      "description": "E.164, for example +4791234567.",
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{7,14}$"
    },
    "Role": {
      "title": "Role",
      "type": "string",
      "enum": ["laerer", "assistent", "sfo"]
    },
    "Subject": {
      "title": "Subject",
      "type": "string",
      "enum": [
        "norsk", "matematikk", "engelsk", "naturfag", "samfunnsfag", "krle",
        "kunst_og_handverk", "musikk", "mat_og_helse", "kroppsoving",
        "fremmedsprak", "valgfag", "annet"
      ]
    },
    "ShiftStatus": {
      "title": "ShiftStatus",
      "type": "string",
      "enum": [
        "pending", "offering", "claimed", "confirmed", "completed",
        "cancelled", "escalated", "manually_assigned", "unfilled", "withdrawn"
      ]
    },
    "OfferStatus": {
      "title": "OfferStatus",
      "type": "string",
      "enum": [
        "queued", "sent", "accepted", "declined", "expired",
        "superseded", "withdrawn", "undone"
      ]
    },
    "SubstituteStatus": {
      "title": "SubstituteStatus",
      "type": "string",
      "enum": ["active", "paused", "left"]
    },
    "Channel": {
      "title": "Channel",
      "type": "string",
      "enum": ["push", "sms"]
    }
  }
}